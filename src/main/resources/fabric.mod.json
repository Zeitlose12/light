{
	"schemaVersion": 1,
	"id": "light",
	"version": "1.4.0",
	"name": "Light",
	"description": "Light - fishing gambling animations for Hypixel SkyBlock (Wiki Tiki and Titanoboa from SkyMaxx 1.0.1 by Rachie, MIT, Copyright (c) 2026 SkyMaxx), a fishing dye tracker (dye chance tables based on DyeAddons by anlg, Apache-2.0), small fishing HUDs, a Bazaar Sell Sacks lock and themes.",
	"authors": [
		"Grundsteuer"
	],
	"license": "MIT",
	"icon": "assets/light/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.skymaxx.tiki.TikiGambleClient",
			"com.skymaxx.tiki.light.LightInit"
		],
		"modmenu": [
			"com.skymaxx.tiki.gui.ModMenuIntegration"
		],
		"skyblockapi:imc/pv-profile": [
			"com.skymaxx.tiki.light.dye.PvBridge::onPvLoad"
		]
	},
	"mixins": [
		{
			"config": "light.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"contributors": [
		"Rachie (SkyMaxx, original mod)"
	],
	"breaks": {
		"tikigamble": "*"
	}
}